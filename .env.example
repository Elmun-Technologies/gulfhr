# ============================================================
# Gulf HR Bot — muhit sozlamalari
# ============================================================

# --- Telegram ---
BOT_TOKEN=123456:AAG-your-telegram-bot-token
# Rahbariyat/HR umumiy guruhi (ixtiyoriy). Guruh ID manfiy bo'ladi: -1001234567890
MANAGEMENT_CHAT_ID=

# ============================================================
# Til (i18n)
# ============================================================
# /start da til tanlash oynasi (🇺🇿 O'zbekcha / 🇷🇺 Русский). true/false
LANGUAGE_CHOICE=true
# Tanlash o'chirilgan bo'lsa ishlatiladigan til: uz yoki ru
DEFAULT_LANGUAGE=uz

# ============================================================
# Telegram API (tezlik va "osilib qolish"dan himoya)
# ============================================================
# Bitta so'rov uchun kutish chegarasi (sekund). aiogram standarti 60 s —
# tarmoq uzilsa bot bir daqiqa javob bermay "o'ylanib" qoladi.
TG_REQUEST_TIMEOUT=15
# Bir vaqtda ochiq turishi mumkin bo'lgan HTTPS ulanishlar soni
TG_CONNECTIONS=32
# Long polling: Telegram so'rovni shu vaqt ushlab turadi (sekund)
POLLING_TIMEOUT=10
# Bot qayta ishga tushganda Telegram navbatida turgan update'lar tashlansinmi?
# false (tavsiya) — nomzod bot o'chib turganda bosgan tugmasi yo'qolmaydi va
# suhbat FSM bazasidan davom etadi. true qilsangiz eski xabarlar o'chiriladi.
DROP_PENDING_UPDATES=false
# /diag buyrug'i shaxsiy chatda ham ishlaydigan Telegram user id'lar
# (vergul bilan: 123456789, 987654321). HR guruhida hamma a'zo ishlata oladi.
ADMIN_USER_IDS=
# Necha sekunddan sekin update logga sekin so'rov bo'lib yoziladi
SLOW_REQUEST_THRESHOLD=0.5

# ============================================================
# Nomzodlarni saralash (vakansiya filteri)
# Vakansiya: oziq-ovqat ingredientlari yetkazib beruvchi
# kompaniya uchun Sotuv menejeri / B2B menejer.
# Kodisiz /start yuborgan foydalanuvchi avtomatik ariza
# oqimiga tushadi.
# ============================================================
# Yosh chegarasi (default 18-30 — o'zgartirish mumkin)
CANDIDATE_MIN_AGE=18
CANDIDATE_MAX_AGE=30
# Nomzod doimiy istiqomat qilishi shart bo'lgan shahar
CANDIDATE_CITY=Toshkent
# Rus tilini bilish majburiy talabmi (true/false) — 'Yo'q' javobi rad etilishga olib keladi
CANDIDATE_RUSSIAN_REQUIRED=true
# Nomzod kartasi yuboriladigan HR guruh. Bo'sh bo'lsa MANAGEMENT_CHAT_ID,
# undan keyin LEAD_GROUP_CHAT_ID (eski sozlamalar) ishlatiladi.
CANDIDATES_CHAT_ID=

# --- Baza ---
# SQLite (default) yoki PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/gulf_hr
DATABASE_URL=sqlite+aiosqlite:///./data/gulf_hr.db
# Suhbat holati (FSM) saqlanadigan fayl. Shu fayl tufayli bot qayta ishga
# tushsa (deploy/restart) nomzod yozayotgan ariza yo'qolmaydi.
FSM_DB_PATH=./data/fsm.db

# --- Vaqt mintaqasi ---
TZ=Asia/Tashkent

# --- Log ---
LOG_LEVEL=INFO

# ============================================================
# ESKI mustaqil lead-bot (leadbot/ moduli) — noyob.
# Nomzodlarni saralash hozir Gulf HR boti (yuqoridagi bo'lim)
# ichida ishlaydi. Quyidagi o'zgaruvchilar faqat eski alohida
# botni qo'lda ishga tushirishda ishlatiladi: python -m leadbot.main
# ============================================================
LEADBOT_TOKEN=123456:AAG-your-leadbot-telegram-token
# Eski HR/sotuv guruhi (kompatibilitat). Guruh ID manfiy bo'ladi: -1001234567890
LEAD_GROUP_CHAT_ID=

# Eski lead-bot o'z mezonlari (faqat leadbot.main ishlatadi)
LEAD_MIN_AGE=18
LEAD_MAX_AGE=30
LEAD_REQUIRED_CITY=Toshkent

# Eski lead-bot analitika bazasi
LEAD_DB_PATH=./data/leadbot.db
LEAD_TZ=Asia/Tashkent
