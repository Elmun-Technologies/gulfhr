# ============================================================
# Gulf HR Bot — muhit sozlamalari
# ============================================================

# --- Telegram ---
BOT_TOKEN=123456:AAG-your-telegram-bot-token
# Bosh admin(lar) — vergul bilan ajratilgan Telegram ID
ADMIN_TELEGRAM_IDS=123456789
# Rahbariyat/HR umumiy guruhi (ixtiyoriy). Guruh ID manfiy bo'ladi: -1001234567890
MANAGEMENT_CHAT_ID=

# ============================================================
# Nomzodlarni saralash (vakansiya filteri) — Gulf HR boti
# ichida ishlaydi. Taklif kodsiz /start yuborgan foydalanuvchi
# avtomatik ariza oqimiga tushadi.
# Vakansiya: oziq-ovqat ingredientlari yetkazib beruvchi kompaniya
# uchun Sotuv menejeri / B2B menejer.
# ============================================================
# Yosh chegarasi (default 18-30 — o'zgartirish mumkin)
CANDIDATE_MIN_AGE=18
CANDIDATE_MAX_AGE=30
# Nomzod doimiy istiqomat qilishi shart bo'lgan shahar
CANDIDATE_CITY=Toshkent
# Nomzod kartasi yuboriladigan HR guruh. Bo'sh bo'lsa MANAGEMENT_CHAT_ID,
# undan keyin LEAD_GROUP_CHAT_ID (eski sozlamalar) ishlatiladi.
CANDIDATES_CHAT_ID=

# --- Baza ---
# SQLite (default) yoki PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/gulf_hr
DATABASE_URL=sqlite+aiosqlite:///./data/gulf_hr.db

# --- amoCRM ---
AMO_SUBDOMAIN=gulf
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=https://example.com/amocrm/callback
# Birinchi ishga tushirishda integratsiyadan olingan authorization code
AMO_AUTH_CODE=
# Yoki uzoq muddatli token (client_id/secret o'rniga)
AMO_LONG_TOKEN=

# amoCRM voronkasidagi "yangi lid" bosqichi ID si (bo'sh bo'lsa birinchi bosqich olinadi)
AMO_FIRST_STATUS_ID=

# --- Vaqt mintaqasi ---
TZ=Asia/Tashkent

# --- Webhook server (amoCRM real-time hodisalari uchun) ---
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
# amoCRM webhook so'rovlarini tekshirish uchun maxfiy kalit (?secret=... bilan keladi)
WEBHOOK_SECRET=change-me

# --- Nazorat qoidalari (soat/kun/dona) ---
# Yangi lidga birinchi javob SLA si (daqiqa)
RULE_FIRST_RESPONSE_MINUTES=15
# Ochiq lid vazifasiz necha soat turishi mumkin
RULE_LEAD_WITHOUT_TASK_HOURS=4
# Lid bir bosqichda necha kun qotib qolsa ogohlantirish
RULE_STATUS_STUCK_DAYS=3
# Lidda umuman harakat bo'lmagan kunlar soni
RULE_NO_ACTIVITY_DAYS=5
# Bitta sotuvchidagi ochiq lidlarning maksimal soni
RULE_MAX_OPEN_LEADS=60
# Target sur'atidan necha % orqada qolsa ogohlantirish
RULE_TARGET_LAG_PERCENT=15

# --- Jadval (cron) ---
SYNC_INTERVAL_MINUTES=5
MORNING_DIGEST_CRON=0 9 * * *
EVENING_DIGEST_CRON=30 18 * * *
WEEKLY_REPORT_CRON=0 10 * * mon

# --- Log ---
LOG_LEVEL=INFO

# ============================================================
# ESKI mustaqil lead-bot (leadbot/ moduli) — noyob.
# Nomzodlarni saralash hozir Gulf HR boti (yuqoridagi bo'lim)
# ichida ishlaydi. Quyidagi o'zgaruvchilar faqat Fly iloji uchun:
# - BOT_TOKEN to'ldirilmagan bo'lsa LEADBOT_TOKEN ishlatiladi
# - CANDIDATES_CHAT_ID va MANAGEMENT_CHAT_ID bo'sh bo'lsa
#   LEAD_GROUP_CHAT_ID ishlatiladi
# Eski alohida botni qo'lda ishga tushirish: python -m leadbot.main
# ============================================================

LEADBOT_TOKEN=123456:AAG-your-leadbot-telegram-token
# Eski HR/sotuv guruhi (kompatibilitat). Guruh ID manfiy bo'ladi: -1001234567890
LEAD_GROUP_CHAT_ID=

# Eski lead-bot o'z mezonlari (faqat leadbot.main ishlatadi)
LEAD_MIN_AGE=18
LEAD_MAX_AGE=30
LEAD_REQUIRED_CITY=Toshkent

# --- Eski lead-bot analitika bazasi ---
LEAD_DB_PATH=./data/leadbot.db
LEAD_TZ=Asia/Tashkent
